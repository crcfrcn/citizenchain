{
  "name": "onchina-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "25.2.1"
  },
  "scripts": {
    "dev": "npm run build && vite preview --host localhost --port 5179 --strictPort",
    "dev:raw": "vite",
    "build": "node ../../../scripts/onchina.mjs frontend",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "preview": "vite preview"
  },
  "dependencies": {
    "@ant-design/icons": "5.6.1",
    "@gmb/scanner-react": "file:../../../crates/scanner",
    "@noble/hashes": "2.0.1",
    "antd": "5.29.3",
    "dayjs": "1.11.19",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@types/node": "25.9.5",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "typescript": "6.0.2",
    "vite": "8.0.4",
    "vitest": "3.2.7"
  }
}
