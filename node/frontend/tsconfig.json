{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "paths": {
      "*": [
        "./node_modules/@types/*",
        "./node_modules/*",
        "../../target/test/editor/node/frontend/node_modules/@types/*",
        "../../target/test/editor/node/frontend/node_modules/*"
      ],
      "@gmb/scanner-react": [
        "../../crates/scanner/src/index.ts"
      ],
      "vite": [
        "./node_modules/vite/dist/node/index.d.ts",
        "../../target/test/editor/node/frontend/node_modules/vite/dist/node/index.d.ts"
      ],
      "@vitejs/plugin-react": [
        "./node_modules/@vitejs/plugin-react/dist/index.d.ts",
        "../../target/test/editor/node/frontend/node_modules/@vitejs/plugin-react/dist/index.d.ts"
      ]
    },
    "typeRoots": [
      "./node_modules/@types",
      "./node_modules",
      "../../target/test/editor/node/frontend/node_modules/@types",
      "../../target/test/editor/node/frontend/node_modules"
    ],
    "types": [
      "node",
      "react",
      "react-dom",
      "vite/client"
    ],
    "rootDirs": [
      ".",
      "../../target/test/editor/node/frontend"
    ]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}
